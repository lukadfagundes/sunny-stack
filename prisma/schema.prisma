// Prisma Schema for Neon PostgreSQL
// Discord Bot + Admin Platform Database Schema
// Version: 2.1.0
// Last Updated: 2025-10-29

// Generator configuration for Prisma Client
generator client {
  provider = "prisma-client-js"
}

// Datasource configuration for Neon PostgreSQL
datasource db {
  provider = "postgresql"
  // Use DATABASE_URL for default connection (pooled via Neon)
  url      = env("DATABASE_URL")
  // Use DATABASE_URL_UNPOOLED for direct connection (migrations, schema changes)
  directUrl = env("DATABASE_URL_UNPOOLED")
}

// ============================================================================
// ENUMS
// ============================================================================

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  REVIEW
  COMPLETE
  ARCHIVED
}

enum QuoteStatus {
  PENDING
  APPROVED
  DECLINED
  CONVERTED
}

enum EventType {
  DEPLOYMENT
  UPTIME_CHECK
  ERROR
  ALERT
}

enum Severity {
  INFO
  WARNING
  ERROR
  CRITICAL
}

// ============================================================================
// MODELS - Discord Bot + Admin Platform
// ============================================================================

// 1. Admin Users (Google OAuth)
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  googleId  String?  @unique
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@map("users")
}

// 2. Client Projects
model Project {
  id                  String        @id @default(cuid())
  title               String
  description         String?       @db.Text
  clientName          String
  clientEmail         String
  status              ProjectStatus @default(PLANNING)
  budget              Decimal?      @db.Decimal(10, 2)
  deadline            DateTime?
  googleDriveFolderId String?
  deletedAt           DateTime?     // Soft delete timestamp
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  // Relationships
  quotes          Quote[]
  timeEntries     TimeEntry[]
  discordMessages DiscordMessage[]

  @@index([status])
  @@index([deadline])
  @@index([clientEmail])
  @@index([deletedAt])
  @@map("projects")
}

// 3. Quote Requests from Website
model Quote {
  id           String      @id @default(cuid())
  name         String
  email        String
  company      String?
  projectType  String
  budgetRange  String?
  timeline     String?
  description  String      @db.Text
  requirements String?     @db.Text
  status       QuoteStatus @default(PENDING)
  projectId    String?
  project      Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  deletedAt    DateTime?   // Soft delete timestamp
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  reviewedAt   DateTime?

  // Relationships
  proposals Proposal[]

  @@index([status])
  @@index([email])
  @@index([createdAt])
  @@index([projectId])
  @@index([deletedAt])
  @@map("quotes")
}

// 4. Project Proposals (Generated PDFs)
model Proposal {
  id        String    @id @default(cuid())
  quoteId   String
  quote     Quote     @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  projectId String
  pdfUrl    String    @db.Text // Base64 data URL or cloud storage URL
  sentAt    DateTime? // Timestamp when email was sent
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([quoteId])
  @@index([projectId])
  @@index([createdAt])
  @@map("proposals")
}

// 5. Time Tracking Entries
model TimeEntry {
  id              String   @id @default(cuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  description     String?  @db.Text
  startedAt       DateTime
  endedAt         DateTime?
  durationMinutes Int?
  loggedVia       String   @default("manual") // 'discord' | 'admin' | 'manual'
  createdAt       DateTime @default(now())

  @@index([projectId])
  @@index([startedAt])
  @@map("time_entries")
}

// 6. External Service Monitoring Events
model MonitoringEvent {
  id        String    @id @default(cuid())
  type      EventType
  severity  Severity
  source    String // 'Fly.io' | 'Cloudflare' | 'cron-job.org' | 'Vercel'
  message   String    @db.Text
  metadata  Json?
  timestamp DateTime  @default(now())
  createdAt DateTime  @default(now())

  @@index([type])
  @@index([severity])
  @@index([timestamp])
  @@map("monitoring_events")
}

// 7. Discord Message Audit Log
model DiscordMessage {
  id               String   @id @default(cuid())
  discordMessageId String   @unique
  channelId        String
  userId           String?
  content          String   @db.Text
  messageType      String // 'COMMAND' | 'ALERT' | 'RESPONSE' | 'NOTIFICATION'
  projectId        String?
  project          Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  metadata         Json?
  timestamp        DateTime @default(now())
  createdAt        DateTime @default(now())

  @@index([discordMessageId])
  @@index([channelId])
  @@index([projectId])
  @@index([timestamp])
  @@map("discord_messages")
}

// 8. API Keys for Bot Authentication
model ApiKey {
  id         String    @id @default(cuid())
  name       String
  key        String    @unique
  expiresAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([key])
  @@map("api_keys")
}

// 9. Webhook Configurations (GitHub, Vercel, etc.)
model Webhook {
  id        String   @id @default(cuid())
  name      String
  url       String
  secret    String?
  events    String[] // Array of event types to listen for
  active    Boolean  @default(true)
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
  @@map("webhooks")
}

// 10. System Configuration (Bot Settings)
model SystemConfig {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String   @db.Text
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([key])
  @@map("system_config")
}

// ============================================================================
// LEGACY MODELS - Existing Website Forms
// ============================================================================

// Legacy: Quote Request from Website (keep for backwards compatibility)
model QuoteRequest {
  id          String   @id @default(cuid())
  name        String
  email       String
  company     String?
  projectType String
  description String   @db.Text
  features    String[] @default([])
  timeline    String
  budget      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([email])
  @@index([createdAt])
  @@map("quote_requests")
}

// Legacy: Contact Message (keep for backwards compatibility)
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String   @db.Text
  createdAt DateTime @default(now())
  read      Boolean  @default(false)

  @@index([email])
  @@index([createdAt])
  @@index([read])
  @@map("contact_messages")
}
