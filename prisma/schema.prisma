// Prisma Schema for Neon PostgreSQL
// Discord Bot + Admin Platform Database Schema
// Version: 2.2.0
// Last Updated: 2025-11-02

// Generator configuration for Prisma Client
generator client {
  provider = "prisma-client-js"
}

// Datasource configuration for PostgreSQL
datasource db {
  provider = "postgresql"
  // Use DATABASE_URL for default connection
  url      = env("DATABASE_URL")

  // Connection pooling configuration
  // Optimized for Raspberry Pi 4 (limited resources)
  // Max connections recommended: 20-25 for Pi 4, 30-40 for Pi 5
  // Add ?connection_limit=20 to DATABASE_URL for pooling
  //
  // Example DATABASE_URL formats:
  // - Local development: postgresql://user:password@localhost:5432/dbname?connection_limit=20
  // - Pi production (Docker): postgresql://user:password@postgres:5432/dbname?connection_limit=20
  // - Neon cloud (with pooling): postgresql://user:password@host:5432/dbname?pgbouncer=true&connection_limit=20
}

// ============================================================================
// ENUMS
// ============================================================================

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  REVIEW
  COMPLETE
  ARCHIVED
}

enum QuoteStatus {
  PENDING
  APPROVED
  DECLINED
  CONVERTED
}

enum EventType {
  DEPLOYMENT
  UPTIME_CHECK
  ERROR
  ALERT
}

enum Severity {
  INFO
  WARNING
  ERROR
  CRITICAL
}

enum AlertType {
  DEPLOYMENT
  UPTIME_CHECK
  ERROR
  NOTIFICATION
}

enum ServiceStatus {
  operational
  degraded
  down
}

// ============================================================================
// MODELS - Discord Bot + Admin Platform
// ============================================================================

// 1. Admin Users (Google OAuth)
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String
  googleId  String?  @unique
  avatar    String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([email])
  @@map("users")
}

// 2. Client Projects
model Project {
  id                  String        @id @default(cuid())
  title               String
  description         String?       @db.Text
  clientName          String
  clientEmail         String
  status              ProjectStatus @default(PLANNING)
  budget              Decimal?      @db.Decimal(10, 2)
  deadline            DateTime?
  googleDriveFolderId String?
  deletedAt           DateTime?     // Soft delete timestamp
  createdAt           DateTime      @default(now())
  updatedAt           DateTime      @updatedAt

  // Relationships
  quotes          Quote[]
  timeEntries     TimeEntry[]
  discordMessages DiscordMessage[]

  @@index([status])
  @@index([deadline])
  @@index([clientEmail])
  @@index([deletedAt])
  @@map("projects")
}

// 3. Quote Requests from Website
model Quote {
  id           String      @id @default(cuid())
  name         String
  email        String
  company      String?
  projectType  String
  budgetRange  String?
  timeline     String?
  description  String      @db.Text
  requirements String?     @db.Text
  status       QuoteStatus @default(PENDING)
  projectId    String?
  project      Project?    @relation(fields: [projectId], references: [id], onDelete: SetNull)
  deletedAt    DateTime?   // Soft delete timestamp
  createdAt    DateTime    @default(now())
  updatedAt    DateTime    @updatedAt
  reviewedAt   DateTime?

  // Relationships
  proposals Proposal[]

  @@index([status])
  @@index([email])
  @@index([createdAt])
  @@index([projectId])
  @@index([deletedAt])
  @@map("quotes")
}

// 4. Project Proposals (Generated PDFs)
model Proposal {
  id        String    @id @default(cuid())
  quoteId   String
  quote     Quote     @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  projectId String
  pdfUrl    String    @db.Text // Base64 data URL or cloud storage URL
  sentAt    DateTime? // Timestamp when email was sent
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt

  @@index([quoteId])
  @@index([projectId])
  @@index([createdAt])
  @@map("proposals")
}

// 5. Time Tracking Entries
model TimeEntry {
  id              String   @id @default(cuid())
  projectId       String
  project         Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  description     String?  @db.Text
  startedAt       DateTime
  endedAt         DateTime?
  durationMinutes Int?
  loggedVia       String   @default("manual") // 'discord' | 'admin' | 'manual'
  createdAt       DateTime @default(now())

  @@index([projectId])
  @@index([startedAt])
  @@map("time_entries")
}

// 6. External Service Monitoring Events
model MonitoringEvent {
  id        String    @id @default(cuid())
  type      EventType
  severity  Severity
  source    String // 'Fly.io' | 'Cloudflare' | 'cron-job.org' | 'Vercel'
  message   String    @db.Text
  metadata  Json?
  timestamp DateTime  @default(now())
  createdAt DateTime  @default(now())

  @@index([type])
  @@index([severity])
  @@index([timestamp])
  @@map("monitoring_events")
}

// 6b. Monitoring Alerts (with acknowledgment tracking)
model MonitoringAlert {
  id             String    @id @default(cuid())
  type           AlertType
  severity       Severity
  source         String // Service name or 'bot' or 'database'
  message        String    @db.Text
  timestamp      DateTime  @default(now())
  acknowledged   Boolean   @default(false)
  acknowledgedAt DateTime?
  metadata       Json?
  createdAt      DateTime  @default(now())

  @@index([severity])
  @@index([source])
  @@index([acknowledged])
  @@index([timestamp])
  @@index([source, timestamp]) // Compound index for filtered queries by source with time ordering
  @@map("monitoring_alerts")
}

// 6c. Service Health Checks
model ServiceHealthCheck {
  id           String        @id @default(cuid())
  serviceName  String // 'Fly.io' | 'Cloudflare' | 'cron-job.org' | 'Vercel'
  endpoint     String
  status       ServiceStatus
  responseTime Int? // milliseconds
  statusCode   Int? // HTTP status code
  lastChecked  DateTime      @default(now())
  createdAt    DateTime      @default(now())

  @@index([serviceName])
  @@index([status])
  @@index([lastChecked])
  @@map("service_health_checks")
}

// 7. Discord Message Audit Log
model DiscordMessage {
  id               String   @id @default(cuid())
  discordMessageId String   @unique
  channelId        String
  userId           String?
  content          String   @db.Text
  messageType      String // 'COMMAND' | 'ALERT' | 'RESPONSE' | 'NOTIFICATION'
  projectId        String?
  project          Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)
  metadata         Json?
  timestamp        DateTime @default(now())
  createdAt        DateTime @default(now())

  @@index([discordMessageId])
  @@index([channelId])
  @@index([projectId])
  @@index([timestamp])
  @@map("discord_messages")
}

// 8. API Keys for Bot Authentication
model ApiKey {
  id         String    @id @default(cuid())
  name       String
  key        String    @unique
  expiresAt  DateTime?
  lastUsedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([key])
  @@map("api_keys")
}

// 9. Webhook Configurations (GitHub, Vercel, etc.)
model Webhook {
  id        String   @id @default(cuid())
  name      String
  url       String
  secret    String?
  events    String[] // Array of event types to listen for
  active    Boolean  @default(true)
  metadata  Json?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([active])
  @@map("webhooks")
}

// 10. System Configuration (Bot Settings)
model SystemConfig {
  id          String   @id @default(cuid())
  key         String   @unique
  value       String   @db.Text
  description String?  @db.Text
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([key])
  @@map("system_config")
}

// ============================================================================
// LEGACY MODELS - Existing Website Forms
// ============================================================================

// Legacy: Quote Request from Website (keep for backwards compatibility)
model QuoteRequest {
  id          String   @id @default(cuid())
  name        String
  email       String
  company     String?
  projectType String
  description String   @db.Text
  features    String[] @default([])
  timeline    String
  budget      String
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([email])
  @@index([createdAt])
  @@map("quote_requests")
}

// Legacy: Contact Message (keep for backwards compatibility)
model ContactMessage {
  id        String   @id @default(cuid())
  name      String
  email     String
  subject   String?
  message   String   @db.Text
  createdAt DateTime @default(now())
  read      Boolean  @default(false)

  @@index([email])
  @@index([createdAt])
  @@index([read])
  @@map("contact_messages")
}
