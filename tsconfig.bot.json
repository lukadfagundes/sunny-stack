{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "commonjs",
    "target": "ES2022",
    "moduleResolution": "node",
    "outDir": "./bot/dist",
    "rootDir": ".",
    "declaration": false,
    "sourceMap": true,
    "removeComments": true,
    "esModuleInterop": true,
    "noEmit": false,
    "skipLibCheck": true,
    "strict": false,
    "resolveJsonModule": true,
    "isolatedModules": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noImplicitReturns": false,
    "noFallthroughCasesInSwitch": false,
    "noImplicitAny": false
  },
  "include": [
    "bot/**/*",
    "lib/db/**/*",
    "lib/logger.ts",
    "lib/monitoring/**/*",
    "lib/notifications/**/*",
    "lib/trinity-debug.ts"
  ],
  "exclude": [
    "node_modules",
    "app",
    "components",
    "__tests__",
    "e2e",
    "scripts",
    "bot/dist",
    ".next",
    "lib/admin/**/*",
    "lib/charts/**/*",
    "lib/config-validate.ts",
    "lib/generateResumePDF.ts",
    "lib/google/**/*",
    "lib/middleware/**/*",
    "lib/pdf/**/*"
  ]
}
