# ==============================================================================
# Sunny Stack - Environment Variables Template
# ==============================================================================
# Copy this file to .env.local for local development
# For production, set these variables in Vercel dashboard and Pi .env file
#
# 📖 DOCUMENTATION:
# - Discord Bot Setup: docs/discord-bot-oauth-setup.md
# - Google API Setup: docs/google-api-setup.md
# - GitHub Secrets: docs/github-secrets.md
# - Configuration Validation: lib/config-validate.ts
# ==============================================================================

# ------------------------------------------------------------------------------
# DATABASE (Local PostgreSQL in Docker)
# ------------------------------------------------------------------------------
# 📖 Setup: See DEVELOPMENT-SETUP.md for local PostgreSQL configuration
# For production on Pi, see PI-DEPLOYMENT.md

# PostgreSQL Database Credentials
# Generate password with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
POSTGRES_USER=sunnystack
POSTGRES_PASSWORD=your-secure-password-here-64-characters-recommended
POSTGRES_DB=sunnystack

# Database Connection URL with Connection Pooling
# Connection pooling optimizes database performance and prevents connection exhaustion
# Recommended connection_limit values:
#   - Raspberry Pi 4: 20-25 connections (limited RAM)
#   - Raspberry Pi 5: 30-40 connections (more resources)
#   - Development: 10-15 connections (shared resources)
#
# Format: postgresql://user:password@host:port/database?connection_limit=20
#
# Development (Windows): postgresql://sunnystack:password@localhost:5432/sunnystack?connection_limit=15
# Production (Pi Docker): postgresql://sunnystack:password@postgres:5432/sunnystack?connection_limit=20
DATABASE_URL=postgresql://sunnystack:your-password@localhost:5432/sunnystack?connection_limit=15

# Legacy Neon Variables (DEPRECATED - keeping for reference)
# If you need to revert to Neon cloud database, use these formats:
# DATABASE_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname
# DATABASE_URL_UNPOOLED=postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname
# POSTGRES_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname
# POSTGRES_PRISMA_URL=postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname?pgbouncer=true
# POSTGRES_URL_NON_POOLING=postgresql://user:password@ep-xxx.region.aws.neon.tech/dbname

# ------------------------------------------------------------------------------
# NEXT.JS & AUTHENTICATION
# ------------------------------------------------------------------------------
# Base URL of your application
# Development: http://localhost:3000
# Production: https://sunny-stack.com

NEXTAUTH_URL="http://localhost:3000"

# Secret for NextAuth.js session encryption
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-nextauth-secret-here-replace-this-value"

# Environment mode (development, production, test)
NODE_ENV="development"

# Discord Bot deployment mode (vercel or pi)
# - vercel: Interactions API (webhook-based, stateless, for Vercel deployment)
# - pi: Gateway API (WebSocket-based, persistent connection, for Raspberry Pi or local dev)
# Use "pi" for local development to run the bot with npm run bot:dev
DEPLOYMENT_MODE="pi"

# ------------------------------------------------------------------------------
# ADMIN DASHBOARD SECURITY
# ------------------------------------------------------------------------------
# Admin email address (ONLY this email can access admin dashboard via Google OAuth)
# Example: your-email@gmail.com
# IMPORTANT: Set BOTH variables to the same email address
ADMIN_EMAIL="your-email@example.com"

# Public admin email (same as ADMIN_EMAIL - needed for client-side validation)
# Must be prefixed with NEXT_PUBLIC_ to be available in browser
NEXT_PUBLIC_ADMIN_EMAIL="your-email@example.com"

# Admin route hash (64-character hex string - keeps admin URL secret)
# ⚠️ CRITICAL: Store this in your password manager! This protects your admin dashboard.
# Admin URL will be: https://sunny-stack.com/admin-{ADMIN_ROUTE_HASH}/
# This hash is already generated for you: 6bde736bb52aa194f1d69d140619b25cb9f9a42eb3acb1f6e7a502b375fda6ac
# To generate a new one: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
ADMIN_ROUTE_HASH="6bde736bb52aa194f1d69d140619b25cb9f9a42eb3acb1f6e7a502b375fda6ac"

# ------------------------------------------------------------------------------
# GOOGLE OAUTH & APIs
# ------------------------------------------------------------------------------
# 📖 Setup Guide: docs/google-api-setup.md
# Required APIs: Gmail, Drive, Calendar, Sheets, Docs, Tasks, People, Analytics

# OAuth 2.0 Client ID (from Google Cloud Console > Credentials)
# Example: 123456789-abc123.apps.googleusercontent.com
# See: docs/google-api-setup.md#step-4-create-oauth-20-credentials
GOOGLE_CLIENT_ID="your-client-id.apps.googleusercontent.com"

# OAuth 2.0 Client Secret (from Google Cloud Console > Credentials)
# Example: GOCSPX-abc123def456
# See: docs/google-api-setup.md#step-4-create-oauth-20-credentials
GOOGLE_CLIENT_SECRET="your-client-secret"

# OAuth 2.0 Redirect URI (MUST match Google Cloud Console exactly)
# Development: http://localhost:3000/api/auth/callback/google
# Production: https://sunny-stack.com/api/auth/callback/google
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/callback/google"

# OAuth 2.0 Refresh Token (long-lived token for API access)
# Obtain from OAuth Playground or custom script
# See: docs/google-api-setup.md#step-5-obtain-refresh-token
GOOGLE_REFRESH_TOKEN="your-refresh-token"

# Google Cloud Project ID (from Google Cloud Console > Project Info)
# Example: sunny-stack-bot
# See: docs/google-api-setup.md#step-1-create-google-cloud-project
GOOGLE_PROJECT_ID="your-project-id"

# ⚠️ OPTIONAL: Service Account Credentials (for server-to-server auth)
# Only needed if using service accounts instead of OAuth
# Leave empty if using OAuth (recommended for this project)

# Service Account Private Key (from service account JSON key file)
GOOGLE_PRIVATE_KEY=""

# Service Account Email (from service account JSON key file)
GOOGLE_CLIENT_EMAIL=""

# ------------------------------------------------------------------------------
# DISCORD BOT
# ------------------------------------------------------------------------------
# 📖 Setup Guide: docs/discord-bot-oauth-setup.md
# Enable Developer Mode in Discord: User Settings → Advanced → Developer Mode

# Bot Token (from Discord Developer Portal > Bot > Token section)
# ⚠️ NEVER share this token! It gives full access to your bot.
# See: docs/discord-bot-oauth-setup.md#step-6-copy-bot-token
DISCORD_BOT_TOKEN="your-discord-bot-token"

# Discord Application ID (from Discord Developer Portal > General Information)
# Example: 1432712159216930926
# See: docs/discord-bot-oauth-setup.md#environment-variables-to-save
DISCORD_APPLICATION_ID="1432712159216930926"

# Discord Server (Guild) ID (right-click server icon > Copy Server ID)
# Make sure Developer Mode is enabled!
# See: docs/discord-bot-oauth-setup.md#how-to-get-server-guild-id
DISCORD_GUILD_ID="your-guild-id"

# Your Discord User ID (right-click your username anywhere > Copy User ID)
# This is the admin who can use all bot commands
# See: docs/discord-bot-oauth-setup.md#how-to-get-your-user-id
DISCORD_ADMIN_USER_ID="your-user-id"

# Channel IDs (right-click channel > Copy Channel ID)
# Make sure Developer Mode is enabled!
# See: docs/discord-bot-oauth-setup.md#how-to-get-channel-ids

# 📋 ADMINISTRATIVE CHANNELS
# #admin-logs - Bot activity logs, configuration changes
DISCORD_CHANNEL_ADMIN_LOGS="your-admin-logs-channel-id"

# #bot-commands - Admin commands and bot configuration
DISCORD_CHANNEL_BOT_COMMANDS="your-bot-commands-channel-id"

# 💼 PROJECT MANAGEMENT CHANNELS
# #active-projects - Active client projects tracking
DISCORD_CHANNEL_ACTIVE_PROJECTS="your-active-projects-channel-id"

# #proposals - Client proposals and quotes
DISCORD_CHANNEL_PROPOSALS="your-proposals-channel-id"

# #tasks - Task tracking and management
DISCORD_CHANNEL_TASKS="your-tasks-channel-id"

# #time-tracking - Time entry logs and summaries
DISCORD_CHANNEL_TIME_TRACKING="your-time-tracking-channel-id"

# 👥 CLIENT COMMUNICATION CHANNELS
# #client-inquiries - New client inquiries from contact/quote forms
DISCORD_CHANNEL_CLIENT_INQUIRIES="your-client-inquiries-channel-id"

# #client-updates - Updates sent to clients
DISCORD_CHANNEL_CLIENT_UPDATES="your-client-updates-channel-id"

# 📊 AUTOMATION & MONITORING CHANNELS
# #calendar-sync - Google Calendar event notifications
DISCORD_CHANNEL_CALENDAR_SYNC="your-calendar-sync-channel-id"

# #email-notifications - Gmail monitoring and notifications
DISCORD_CHANNEL_EMAIL_NOTIFICATIONS="your-email-notifications-channel-id"

# #analytics - Website analytics and metrics
DISCORD_CHANNEL_ANALYTICS="your-analytics-channel-id"

# 💰 FINANCIAL CHANNELS
# #invoices - Invoice generation and tracking
DISCORD_CHANNEL_INVOICES="your-invoices-channel-id"

# #payments - Payment notifications and tracking
DISCORD_CHANNEL_PAYMENTS="your-payments-channel-id"

# ------------------------------------------------------------------------------
# BOT API AUTHENTICATION
# ------------------------------------------------------------------------------
# The bot communicates with Next.js API via HTTP (decoupled architecture)
# This allows independent deployment: Next.js on Vercel, Bot on Raspberry Pi

# Shared secret for bot-to-API authentication
# Generate with: openssl rand -hex 32
# ⚠️ CRITICAL: Keep this secret! Bot uses it to authenticate with your API.
BOT_API_KEY="your-bot-api-key-replace-this-value"

# Base URL of Next.js API (for bot to make HTTP requests)
# Development (Windows): http://localhost:3000/api
# Development (Pi with api-server container): http://api-server:3000/api
# Production (Pi with api-server container): http://api-server:3000/api
# Production (Vercel site): https://sunny-stack.com/api
BOT_API_URL="http://localhost:3000/api"

# ------------------------------------------------------------------------------
# EMAIL (Resend)
# ------------------------------------------------------------------------------
# Resend API key for sending emails (contact form, notifications)
# Get from: https://resend.com/api-keys
# Format: re_xxxxxxxxxxxxxxxxxxxx
RESEND_API_KEY="re_YOUR_RESEND_API_KEY_HERE"

# ------------------------------------------------------------------------------
# WEBHOOKS
# ------------------------------------------------------------------------------
# Webhook secrets for signature verification (security)
# Generate unique secrets for each service

# Discord webhook URL (for deployment/build notifications to Discord channel)
# Get from: Discord → Right-click channel → Edit Channel → Integrations → Webhooks → New Webhook → Copy Webhook URL
# Format: https://discord.com/api/webhooks/[ID]/[TOKEN]
# Used by GitHub Actions to send deployment status notifications
# IMPORTANT: Also add to GitHub Secrets (Settings → Secrets → Actions → New secret)
DISCORD_WEBHOOK_URL="https://discord.com/api/webhooks/your-webhook-id/your-webhook-token"

# GitHub webhook secret (for deployment notifications)
# Set in: GitHub Repo → Settings → Webhooks → Add webhook
# Generate with: openssl rand -hex 20
GITHUB_WEBHOOK_SECRET="your-github-webhook-secret"

# Vercel webhook secret (for deployment notifications)
# Set in: Vercel Project → Settings → Git → Deploy Hooks
# Generate with: openssl rand -hex 20
VERCEL_WEBHOOK_SECRET="your-vercel-webhook-secret"

# ------------------------------------------------------------------------------
# ERROR MONITORING (Rollbar)
# ------------------------------------------------------------------------------
# Rollbar access token for error tracking and monitoring
# Get from: https://rollbar.com (after creating an account and project)
# Format: rollbar_token_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
ROLLBAR_ACCESS_TOKEN="your_rollbar_token_here"

# ------------------------------------------------------------------------------
# MONITORING & EXTERNAL SERVICES
# ------------------------------------------------------------------------------
# 📖 Setup Guides:
#    - docs/fly-io-setup.md
#    - docs/cloudflare-api-setup.md
#    - docs/cronjob-api-setup.md
# These services monitor your active client projects and infrastructure

# Fly.io API token (for monitoring projects deployed on Fly.io)
# Required: You have active projects on Fly.io
# Get from: https://fly.io/user/personal_access_tokens
# See: docs/fly-io-setup.md
FLY_API_TOKEN="your-fly-io-api-token"

# Fly.io Organization Slug (your organization identifier)
# Get from: Dashboard URL or run: flyctl orgs list
# See: docs/fly-io-setup.md
FLY_ORG_SLUG="your-org-slug"

# Cloudflare API token (for DNS/CDN monitoring and management)
# Required: You use Cloudflare for DNS/CDN
# Get from: https://dash.cloudflare.com/profile/api-tokens
# See: docs/cloudflare-api-setup.md
CLOUDFLARE_API_TOKEN="your-cloudflare-api-token"

# Cloudflare Zone ID (for specific domain management)
# Get from: Cloudflare Dashboard → Domain → Overview (right sidebar)
# See: docs/cloudflare-api-setup.md
CLOUDFLARE_ZONE_ID="your-cloudflare-zone-id"

# cron-job.org API key (for external cron job monitoring)
# Required: You use cron-job.org for scheduled tasks
# Get from: https://cron-job.org/en/members/api/
# See: docs/cronjob-api-setup.md
CRONJOB_API_KEY="your-cronjob-api-key"

# ------------------------------------------------------------------------------
# DEPLOYMENT & CI/CD
# ------------------------------------------------------------------------------
# GitHub username (for Docker image tagging in CI/CD)
# Example: lukadfagundes
GITHUB_USERNAME="your-github-username"

# ==============================================================================
# QUICK START SETUP CHECKLIST
# ==============================================================================
# Follow these steps to get your environment configured:
#
# STEP 1: Copy this file
#   cp .env.example .env.local
#
# STEP 2: Database Setup (5 min)
#   [ ] Generate secure PostgreSQL password
#   [ ] Update POSTGRES_PASSWORD in .env.local
#   [ ] Start PostgreSQL container: docker compose -f docker-compose.dev.yml up -d postgres
#   [ ] Run Prisma migrations: npx prisma migrate dev
#
# STEP 3: Generate Secrets (2 min)
#   [ ] NEXTAUTH_SECRET: openssl rand -base64 32
#   [ ] BOT_API_KEY: openssl rand -hex 32
#   [ ] GITHUB_WEBHOOK_SECRET: openssl rand -hex 20
#   [ ] VERCEL_WEBHOOK_SECRET: openssl rand -hex 20
#
# STEP 4: Google OAuth Setup (20-30 min)
#   [ ] Follow: docs/google-api-setup.md
#   [ ] Create Google Cloud project
#   [ ] Enable 8 APIs
#   [ ] Create OAuth credentials
#   [ ] Obtain refresh token
#   [ ] Copy GOOGLE_CLIENT_ID, GOOGLE_CLIENT_SECRET, GOOGLE_REFRESH_TOKEN
#
# STEP 5: Discord Bot Setup (10-15 min)
#   [ ] Follow: docs/discord-bot-oauth-setup.md
#   [ ] Create bot in Discord Developer Portal
#   [ ] Generate OAuth2 URL and invite to server
#   [ ] Copy DISCORD_BOT_TOKEN
#   [ ] Enable Developer Mode in Discord
#   [ ] Copy server ID, channel IDs, and user ID
#
# STEP 6: Raspberry Pi Setup (Optional - for deployment)
#   [ ] Follow: docs/github-secrets.md
#   [ ] Install Docker on Pi
#   [ ] Configure SSH access
#   [ ] Create production .env on Pi
#
# STEP 7: Validate Configuration
#   [ ] Run: npx ts-node lib/config-validate.ts
#   [ ] Fix any errors reported
#   [ ] Confirm all required variables are set
#
# ==============================================================================
# TOTAL SETUP TIME: ~1-2 hours
# ==============================================================================
