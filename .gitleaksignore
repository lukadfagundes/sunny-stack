# Gitleaks ignore file - prevents false positives

# Test files and mock data
**/test/**
**/tests/**
**/__tests__/**
**/spec/**
**/__mocks__/**
**/*.test.*
**/*.spec.*
**/*.mock.*

# Documentation
**/docs/**
**/documentation/**
**/*.md
**/*.txt

# Package files (often contain example keys)
package-lock.json
yarn.lock
pnpm-lock.yaml

# Environment example files
**/.env.example
**/.env.template
**/.env.sample

# Common development files
**/.vscode/**
**/.idea/**
**/node_modules/**

# Build outputs
**/dist/**
**/build/**
**/out/**
**/.next/**

# Common false positives
**/jest.setup.js
**/jest.config.*

# Trinity Method files (if they contain example data)
**/trinity/**

# Specific false positives for this project
# Jest setup file contains test API key
jest.setup.js:29
jest.setup.js:test_api_key_for_jest_testing
# Any line containing test API key patterns
test_api_key
test_api_key_for_jest_testing
mock_api_key_for_build
# Workflow environment variables for build
*.yml:mock_api_key_for_build
*.yaml:mock_api_key_for_build
