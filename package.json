{
  "name": "sunny-stack-portfolio",
  "version": "2.0.1",
  "description": "Professional development portfolio showcasing Trinity Method",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "build:bot": "tsc --project tsconfig.bot.json",
    "build:bot:check": "tsc --project tsconfig.bot.json --noEmit",
    "build:bot:watch": "tsc --project tsconfig.bot.json --watch",
    "start": "next start",
    "lint": "next lint",
    "type-check": "tsc --noEmit",
    "export": "next build",
    "test": "jest --passWithNoTests",
    "test:ci": "jest --passWithNoTests --maxWorkers=2",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:debug": "playwright test --debug",
    "lint:fix": "next lint --fix",
    "analyze": "ANALYZE=true npm run build",
    "analyze:server": "ANALYZE=true BUNDLE_ANALYZE=server npm run build",
    "analyze:browser": "ANALYZE=true BUNDLE_ANALYZE=browser npm run build",
    "bot:dev": "dotenv -e .env.local -- tsx bot/index.ts",
    "bot:deploy": "tsx scripts/deploy-commands.ts",
    "bot:test": "tsx scripts/test-bot-commands.ts",
    "validate:env:pi": "tsx scripts/validate-env.ts --mode=pi",
    "validate:env:vercel": "tsx scripts/validate-env.ts --mode=vercel",
    "validate:env": "tsx scripts/validate-env.ts",
    "validate:prerequisites": "bash scripts/validate-prerequisites.sh"
  },
  "dependencies": {
    "@discordjs/builders": "^1.7.0",
    "@discordjs/rest": "^2.2.0",
    "@noble/ed25519": "^2.3.0",
    "@prisma/client": "^6.18.0",
    "@types/recharts": "^1.8.29",
    "@typescript-eslint/eslint-plugin": "^8.45.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vercel/postgres": "^0.10.0",
    "autoprefixer": "^10.4.21",
    "discord-api-types": "^0.37.74",
    "discord.js": "^14.14.1",
    "dotenv": "^17.2.3",
    "eslint": "^9.37.0",
    "eslint-config-next": "^16.0.0",
    "html2canvas": "^1.4.1",
    "jspdf": "^3.0.2",
    "lucide-react": "^0.544.0",
    "next": "^15.0.0",
    "next-auth": "^5.0.0-beta.30",
    "pg": "^8.16.3",
    "postcss": "^8.5.6",
    "prisma": "^6.18.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "recharts": "^3.3.0",
    "resend": "^6.0.3",
    "rollbar": "^2.26.5",
    "tailwindcss": "^3.4.0",
    "winston": "^3.18.3",
    "winston-daily-rotate-file": "^5.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.2",
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.0.0",
    "@next/bundle-analyzer": "^15.5.3",
    "@playwright/test": "^1.55.0",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^24.5.2",
    "@types/pg": "^8.15.6",
    "@types/react": "^19.1.14",
    "@types/react-dom": "^19.1.9",
    "dotenv-cli": "^11.0.0",
    "jest": "^30.1.3",
    "jest-environment-jsdom": "^30.2.0",
    "js-yaml": "^4.1.0",
    "markdownlint-cli": "^0.46.0",
    "tsc-alias": "^1.8.16",
    "tsx": "^4.20.6",
    "typescript": "^5.5.0"
  },
  "engines": {
    "node": ">=18.17.0"
  }
}
